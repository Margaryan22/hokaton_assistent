# Все модели — бесплатные, с Hugging Face. Скачиваются при первом запуске в ~/.cache/huggingface.
# Значение auto включает модель, если установлены её пакеты (pip install -r requirements-ml.txt).

# Понимание фраз: local (LLM с Hugging Face через llama.cpp), claude (платный API), off (только правила), auto.
LLM_BACKEND=auto
# qwen3-4b-2507 (по умолчанию) | qwen3.5-4b | qwen3.5-2b | qvikhr-3-4b — сравнение в README.
LOCAL_LLM_MODEL=qwen3-4b-2507
# Свой GGUF-файл вместо скачивания с Hugging Face (необязательно).
LOCAL_LLM_PATH=
# Только для LLM_BACKEND=claude.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Распознавание речи на сервере: gigaam-v3-e2e-rnnt | t-tech/t-one | alphacep/vosk-model-ru | off (браузер) | auto.
STT_MODEL=auto
# Голос Silero v5: xenia | baya | kseniya | aidar | eugene | off (озвучка браузером) | auto.
TTS_SPEAKER=auto
# Эмбеддинги для смыслового поиска: deepvk/USER2-small | deepvk/USER2-base | deepvk/USER-bge-m3 | off | auto.
EMBEDDINGS_MODEL=auto
# Загружать модели при старте сервера (1) или при первом запросе (0).
PRELOAD_MODELS=1

APP_TIMEZONE=Europe/Moscow
DB_PATH=data/assistant.db
SEED_CSV=data/voice_assistant_events.csv
SEED_USER=demo
